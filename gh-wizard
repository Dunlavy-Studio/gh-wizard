#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__.'/vendor/autoload.php';

use Dunlavystudio\GhWizard\Commands\WizardCommand;
use Symfony\Component\Console\Application;

$application = new Application(
        'GitHub Wizard',
        '0.1.0'
);

$application->addCommand(new WizardCommand());

$application->setDefaultCommand('wizard', true);

exit($application->run());