{
    "name": "dunlavystudio/gh-wizard",
    "description": "An interactive wizard for GitHub CLI",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dunlavystudio\\GhWizard\\": "src/"
        }
    },
    "authors": [
        {
            "name": "JayDunlavy",
            "email": "30965312+JayDunlavyHome@users.noreply.github.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4.1",
        "laravel/prompts": "^0.3.28",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "pestphp/pest": "^5.3",
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
